# Copy to .env.local and fill in. Never commit .env.local.

# FalkorDB. FalkorDB Cloud free tier: create an instance at https://app.falkordb.cloud,
# then copy host, port, username and password from the Connectivity tab (the port is often not 6379).
# Use falkors:// when the instance requires TLS, and percent-encode @ : / # ? in the password.
FALKORDB_URL=falkor://falkordb:<password>@<host>:<port>

# Free LLM providers, tried in this order. At least one is needed for live agent runs.
# Without a key (or once the free quota is spent) the controller runs its standard procedure
# as code on the same graph tools, labeled "scripted"; without a database, recorded runs play back.
# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Optional model overrides (provider:model).
# AGENT_MODEL_PRIMARY=google:gemini-flash-latest
# AGENT_MODEL_FALLBACK=groq:openai/gpt-oss-120b

# Protects the keep-alive and sandbox-cleanup cron routes. Any long random string.
CRON_SECRET=
