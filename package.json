{
  "name": "detour",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "build:data": "tsx scripts/build-network.ts data/raw data/nyc && tsx scripts/build-map.ts",
    "fetch:data": "bash scripts/fetch-mta.sh",
    "test:e2e": "playwright test",
    "verify": "uv run --with networkx python scripts/verify/verify.py data/nyc data/scenarios.json data/nyc/verify",
    "ci:scenarios": "tsx scripts/ci/run-scenarios.ts && node scripts/ci/trim-proof.mjs",
    "ci:bench": "tsx scripts/ci/bench.ts",
    "record": "tsx scripts/record-replay.ts",
    "eval": "tsx scripts/eval/build-questions.ts && tsx scripts/eval/run-eval.ts",
    "eval:memory": "tsx scripts/eval/memory-eval.ts",
    "deadcode": "knip"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/groq": "^4.0.61",
    "@modelcontextprotocol/server": "2.3.1",
    "ai": "7.0.142",
    "falkordb": "6.8.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "knip": "^5.88.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.28.3",
  "description": "Agents on a FalkorDB graph of the New York City subway: who a closure hits, what the network can carry (max flow, min cut), shuttle plans tested on forked graphs, and rider advisories with memory."
}
